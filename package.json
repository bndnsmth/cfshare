{
  "name": "cfshare",
  "version": "0.1.0",
  "description": "Share encrypted, expiring files and folders through Cloudflare Drop or your own Worker.",
  "keywords": [
    "cli",
    "cloudflare",
    "encryption",
    "file-sharing",
    "temporary"
  ],
  "homepage": "https://github.com/bndnsmth/cfshare#readme",
  "bugs": {
    "url": "https://github.com/bndnsmth/cfshare/issues"
  },
  "license": "MIT",
  "author": "Brandon Smith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndnsmth/cfshare.git"
  },
  "bin": {
    "cfshare": "dist/cfshare.js"
  },
  "files": [
    "dist",
    "client.d.ts",
    "CHANGELOG.md",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "prepack": "npm run build",
    "benchmark:local": "tsx benchmark/local-do.ts",
    "worker:types": "wrangler types",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@types/node": "^24.0.0",
    "wrangler": "^4.123.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "4.23.12",
    "vite-plus": "0.2.9",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.16.0",
  "cloudflare": {
    "bindings": {
      "UPLOAD_TOKEN": {
        "description": "Required bearer token for uploads. Generate a unique value with `openssl rand -hex 32`."
      }
    }
  }
}
