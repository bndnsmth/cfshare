{
  "name": "cfshare-celld",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARES",
        "class_name": "ShareObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShareObject"],
    },
  ],
  "vars": {
    "UPLOAD_TOKEN": "",
    "BRAND_NAME": "cfshare on celld",
    "BRAND_SUMMARY": "Encrypted, expiring transfers on self-hosted Durable Objects.",
    "BRAND_LOGO_URL": "",
    "BRAND_BACKGROUND": "#101820",
    "BRAND_FOREGROUND": "#f7f4ed",
    "BRAND_ACCENT": "#ffb81c",
    "DEFAULT_TTL_SECONDS": "3600",
    "MIN_TTL_SECONDS": "10",
    "MAX_TTL_SECONDS": "2592000",
    "MAX_UPLOAD_BYTES": "262144016",
    "PUBLIC_ORIGIN": "",
  },
}
